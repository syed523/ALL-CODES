#include <stdio.h>

int main() {
    int a, b;

    // Read the two integers defining the interval [a, b]
    scanf("%d", &a);
    scanf("%d", &b);

    // Array storing string representations for numbers 1 to 9
    char *words[] = {
        "one", "two", "three", "four", "five",
        "six", "seven", "eight", "nine"
    };

    // Iterate through each integer i in the interval [a, b]
    for (int i = a; i <= b; i++) {
        if (i >= 1 && i <= 9) {
            // Print the lowercase English representation for numbers 1 to 9
            printf("%s\n", words[i - 1]);
        } else if (i % 2 == 0) {
            // Print "even" if i > 9 and i is even
            printf("even\n");
        } else {
            // Print "odd" if i > 9 and i is odd
            printf("odd\n");
        }
    }

    return 0;
}
